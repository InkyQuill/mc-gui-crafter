{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCGUI Crafter",
  "version": "0.0.1-alpha",
  "identifier": "net.inkyquill.mc-gui-crafter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:49320",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MCGUI Crafter",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Development",
    "shortDescription": "Desktop GUI editor for Minecraft machine screens"
  }
}
